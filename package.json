{
  "name": "rcfc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:wasm && vite",
    "build": "bun run build:wasm && bun run typecheck && bun --bun vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "cf-typegen": "wrangler types worker/env.d.ts --env-interface Env",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf": "scripts/cf.sh",
    "cf:bootstrap": "scripts/cf.sh scripts/bootstrap.sh",
    "deploy:preview": "scripts/cf.sh scripts/deploy.sh preview",
    "deploy:prod": "scripts/cf.sh scripts/deploy.sh production",
    "check:deploy": "scripts/check-deploy.sh",
    "build:wasm": "scripts/build-wasm.sh",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@types/bun": "1.3.6",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@fontsource/balsamiq-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "dexie": "4.4.7",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.3.6"
}
